# --- App ---
ENVIRONMENT=development

# --- Security: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"` ---
SECRET_KEY=change-me-to-a-long-random-string

# --- CORS: comma-free list, JSON array format also accepted ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Database: SQLite by default. For production use Postgres, e.g.: ---
# DATABASE_URL=postgresql://documind:documind@postgres:5432/documind
DATABASE_URL=sqlite:///./documind.db

# --- Groq LLM (get a free key at https://console.groq.com) ---
GROQ_API_KEY=your-groq-api-key-here
# llama-3.1-8b-instant was deprecated by Groq on 2026-08-16.
# openai/gpt-oss-20b is the current fast/cheap default; see
# https://console.groq.com/docs/models for the full current list.
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings (runs locally, no API key needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
